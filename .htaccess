Options -Indexes
DirectoryIndex intro.php index.php index.html
RewriteEngine On
# Withdrawn privacy-sensitive media.
RewriteRule ^feed/images/(20260907-220544-147e0f3ea5|20260907-220503-d5b1f49c93|20260907-220533-95f371bb60)\.jpg$ - [G,L,NC]
RewriteRule ^\.env - [F,L]
RewriteRule ^app/ - [F,L]
RewriteRule ^feed/feed-data/ - [F,L]
RewriteRule ^prompts/ - [F,L]
RewriteRule ^lore/ - [F,L]
RewriteRule ^storage/ - [F,L]
RewriteRule ^data/jack/ - [F,L]
RewriteRule ^\.well-known/acme-challenge/ - [L]
RewriteCond %{HTTP_HOST} ^(?:www\.)?ffilm\.org$ [NC]
RewriteRule ^(.*)$ https://timetravellersguild.com/$1 [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.timetravellersguild\.com$ [NC]
RewriteRule ^(.*)$ https://timetravellersguild.com/$1 [R=301,L,NE]
RewriteRule ^station/([a-z0-9-]+)/?$ station/index.php?slug=$1 [QSA,L,NC]
RewriteRule ^$ /intro.php [L]
RewriteRule ^index\.html$ /intro.php [L]
RewriteRule ^now/capture/?$ /now/capture.php [L]
RewriteRule ^now/jack/?$ /now/jack.php [L]
RewriteRule ^now/around/?$ /now/around.php [L,QSA]
RewriteRule ^now/tree/?$ /now/tree/index.php [L]
RewriteRule ^now/?$ /now/index.php [L]
RewriteRule ^jack/speak/?$ /jack/speak.php [L]
RewriteRule ^jack/room-action/?$ /jack/room-action.php [L]
RewriteRule ^jack/office-action/?$ /jack/office-action.php [L]
RewriteRule ^jack/office/?$ /jack/office.php [L]
RewriteRule ^jack/ledger/?$ /jack/ledger.php [L]
RewriteRule ^jack/puzzle/check(?:\.php)?/?$ /jack/puzzle/check.php [L]
RewriteRule ^jack/puzzle/?$ /jack/puzzle/index.php [L]
RewriteRule ^deck/([a-z0-9-]+)/?$ /jack/tarot/deck/index.php?card=$1 [L,QSA]
RewriteRule ^deck/?$ /jack/tarot/deck/index.php [L,QSA]
RewriteRule ^jack/tarot/deck/([a-z0-9-]+)/?$ /jack/tarot/deck/index.php?card=$1 [L,QSA]
RewriteRule ^jack/tarot/deck/?$ /jack/tarot/deck/index.php [L,QSA]
RewriteRule ^jack/tarot/?$ /jack/tarot/index.php [L]
RewriteRule ^jack/body/?$ /jack/body/index.html [L]
RewriteRule ^jack/room/?$ /jack/room/index.html [L]
RewriteRule ^jack/map/?$ /jack/map/index.html [L]
RewriteRule ^square/?$ /square/index.php [L]
RewriteRule ^one/?$ /jack [R=302,L]
RewriteRule ^chat/?$ /people/chat/ [R=302,L]
RewriteRule ^cube/?$ /cube/index.php [L]
RewriteRule ^machine/?$ /machine/index.php [L]
RewriteRule ^arianrhod/?$ /arianrhod/index.php [L]
RewriteRule ^api/machine/state/?$ /machine/api.php [L,QSA]
RewriteRule ^api/map/([a-z]+)/?$ /jack/map/api.php?op=$1 [L,QSA]
RewriteRule ^jack/?$ /jack/index.php [L]
RewriteRule ^field/?$ /field/index.php [L]
RewriteRule ^view/observe/?$ /view/observe.php [L]
RewriteRule ^view/?$ /view/index.php [L]
RewriteRule ^ad/?$ /ad/index.html [L]
RewriteRule ^auction/?$ /auction/index.php [L]
RewriteRule ^auction/request(?:\.php)?/?$ /auction/request.php [L]
RewriteRule ^auction/confirm(?:\.php)?/?$ /auction/confirm.php [L,QSA]
RewriteRule ^feed/?$ /feed/index.php [L,QSA]
RewriteRule ^intro/act(?:\.php)?/?$ /intro/act.php [L]
RewriteRule ^intro/voice(?:\.php)?/?$ /intro/voice.php [L]
RewriteRule ^play/act(?:\.php)?/?$ /play/act.php [L]
RewriteRule ^join/act(?:\.php)?/?$ /join/act.php [L]
RewriteRule ^join/?$ /join/index.php [L]
RewriteRule ^navigator/act(?:\.php)?/?$ /navigator/act.php [L]
RewriteRule ^navigator/?$ /navigator/index.php [L]
RewriteRule ^n/?$ n/index.php [L]
RewriteRule ^n/([A-Za-z0-9_-]+)/?$ n/index.php?id=$1 [L,QSA]
<FilesMatch "^\.env">
Require all denied
</FilesMatch>
<IfModule LiteSpeed>
CacheDisable public /
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
<FilesMatch "\.(html|php)$">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Pragma "no-cache"
Header always set Expires "0"
</FilesMatch>
</IfModule>